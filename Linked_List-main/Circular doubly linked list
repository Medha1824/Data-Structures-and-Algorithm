#include <bits/stdc++.h>
using namespace std;

struct node{
    int data;
    node *prev;
    node *next;
};
node *head=NULL;

void insertFirst(int val){
    node *temp;
    temp=new node();
    temp->data=val;
    if(head==NULL){
        temp->prev=temp;
        temp->next=temp;
        head=temp;
    }
    else{
        node *last;
        last=head->prev;

        temp->next=head;
        head->prev=temp;
        temp->prev=last;
        last->next=temp;
        head=temp;
    }
}

void insertLast(int val){
    if(head==NULL)
        insertFirst(val);
    else{
        node *temp;
        temp=new node();
        temp->data=val;
        node *last=head->prev;
        temp->next=head;
        temp->prev=last;
        last->next=temp;
        head->prev=temp;
    }
}

void insertAtPosition(int val,int pos){
    if(pos==1){
        insertFirst(val);
    }
    else{
        node *temp;
        temp=new node();
        temp->data=val;
        node *ptr=head;
        int place=1;
        while(place<pos-1 && ptr->next!=head ){
            ptr=ptr->next;
            place++;
        }
        if(ptr->next==head && place<pos-1)
            cout<<"Invalid position"<<endl;
        else{
            temp->next=ptr->next;
            temp->prev=ptr;
            ptr->next->prev=temp;
            ptr->next=temp;
        }
    }
}

void insertValue(int val){
    if(head==0 || val<=head->data)
        insertFirst(val);
    else{
        node *temp;
        temp=new node();
        temp->data=val;
        node *ptr=head;
        while(ptr->next !=head && val> ptr->next->data)
            ptr=ptr->next;
        temp->next=ptr->next;
        temp->prev=ptr;
        ptr->next->prev=temp;
        ptr->next=temp;
    }
}

void deleteFirst(){
    if(head==NULL)
        cout<<"List is empty"<<endl;
    else if(head->next==head)
        head=NULL;
    else{
        node *last=head->prev;
        head=head->next;
        head->prev=last;
        last->next=head;
        cout << "First node deletion completed"<<endl;

    }
}

void deleteLast(){
    if(head==NULL)
        cout<<"List is empty"<<endl;
    else if(head->next==head)
        head=NULL;
    else{
        node *last=head->prev;
        node *plast=last->prev;
        plast->next=head;
        head->prev=plast;
        cout << "Last node deletion completed"<<endl;
    }
}

void deleteAtPosition(int pos){
    if(head==NULL)
        cout<<"List is empty"<<endl;
    else if(pos==1)
        deleteFirst();
    else{
        node *ptr=head;
        node *ptr1=head;
        for(int i=1; i<pos-1 && ptr->next !=head; i++)
            ptr=ptr->next;
        if(ptr->next==head)
            cout<<"Invalid position"<<endl;
        else{
            ptr1=ptr->next;
            ptr->next=ptr1->next;
            ptr1->next->prev=ptr;
            cout << "Deletion completed"<<endl;
        }
    }
}

void deleteValue(int val)
{
    if(head==NULL)
        cout<<"List is empty"<<endl;
    else if(val==head->data)
        deleteFirst();
    else{
        node *ptr=head;
        node *ptr1=head;
        while(ptr->next !=head && val !=ptr->next->data)
            ptr=ptr->next;
        if(ptr->next==head)
            cout<<"Invalid Value"<<endl;
        else{
            ptr1=ptr->next;
            ptr->next=ptr1->next;
            ptr1->next->prev=ptr;
            cout << "Deletion completed"<<endl;
        }
    }
}

void printing(){
    if(head==NULL)
        cout<<"List is empty"<<endl;
    else{
        node *ptr=head;
        do{
            cout<<ptr->data<<" ";
            ptr=ptr->next;
        }while(ptr!=head);
        cout<<endl;
    }
}

void searching(int val){
    if(head==NULL)
        cout<<"List is empty"<<endl;
    else{
        node *ptr=head;
        do{
            if(ptr->data == val){
                cout<<"Found"<<endl;
                return;
            }
            ptr=ptr->next;
        }while(ptr!=head);
        cout<<"Not Found"<<endl;
    }
}

void last_node(){
    if(head==NULL)
        cout<<"List is empty"<<endl;
    else{
        node *ptr=head->prev;
        cout<<ptr->data<<endl;
    }
}

void previous_of_last_node(){
    if(head==NULL)
        cout<<"List is empty"<<endl;
    else if(head->next==head)
        cout<<"List's size is one"<<endl;
    else{
        node *ptr=head->prev;
        node *ptr1=ptr->prev;
        cout<<ptr1->data<<endl;
    }
}

void list_size(){
    int cnt=0;
    if(head==NULL)
        cout<<cnt<<endl;
    else{
    node *ptr=head;
    do{
        cnt++;
        ptr=ptr->next;
    }while(ptr!=head);
    cout<<cnt<<endl;
    }
}

void reversePrint(){
    if(head==NULL)
        cout<<"List is empty"<<endl;
    else{
        node *ptr=head->prev;
        do{
            cout<<ptr->data<<" ";
            ptr=ptr->prev;
        }while(ptr!=head->prev);
        cout<<endl;
    }
}

