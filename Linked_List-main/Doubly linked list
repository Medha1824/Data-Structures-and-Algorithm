#include<bits/stdc++.h>
using namespace std;

struct node
{
    int data;
    node* prev;
    node* next;
};
node* root=NULL;
node* tail=NULL;

//1
void insertFirst(int val){
    node* temp=new node();
    temp->data=val;
    temp->prev=NULL;
    if(root==NULL && tail==NULL){
        temp->next=NULL;
        root=temp;
        tail=temp;
    }
    else{
        temp->next=root;
        root->prev=temp;
        root=temp;
    }
}
//2
void insertLast(int val){
    node* temp=new node();
    temp->data=val;
    temp->next=NULL;
    if(root==NULL){
        temp->prev=NULL;
        root=temp;
        tail=temp;
    }
    else{
        temp->prev=tail;
        tail->next=temp;
        tail=temp;
    }
}
//3-a
void insertMiddleByValue(int val){
    node* temp=new node();
    temp->data=val;
    if(root==NULL && tail==NULL){
        temp->next=NULL;
        temp->prev=NULL;
        root=temp;
        tail=temp;
    }
    else if(val< root->data){
        temp->next=root;
        temp->prev=NULL;
        root->prev=temp;
        root=temp;
    }
    else{
        node *ptr=root;
        while(ptr->next !=NULL && val > ptr->next->data)
            ptr=ptr->next;
        temp->next=ptr->next;
        temp->prev=ptr;
        if(ptr->next!=NULL)
            ptr->next->prev=temp;
        else{
            tail=temp;
        }
        ptr->next=temp;
    }
}
//3-b
void insertMiddleByPosition(int val,int pos){
    if(pos<=0){
            cout<<"Invalid position"<<endl;
            return;
    }
    else if(pos==1){
        node* temp=new node();
        temp->data=val;
        if(root==NULL && tail==NULL){
        temp->next=NULL;
        temp->prev=NULL;
        root=temp;
        tail=temp;
    }
    else {
        temp->next=root;
        temp->prev=NULL;
        root->prev=temp;
        root=temp;
    }
    }
    else{
        node *ptr=root;
        int place=1;
        while(place<pos-1 && ptr!=NULL ){
            ptr=ptr->next;
            place++;
        }
        if(ptr==NULL)
            cout<<"Invalid position"<<endl;
        else{
            node* temp=new node();
            temp->data=val;
            temp->next=ptr->next;
            temp->prev=ptr;
            if(ptr->next!=NULL)
                ptr->next->prev=temp;
            else{
                tail=temp;
            }
            ptr->next=temp;
        }
    }
}
//4
void deleteFirst(){
    if(root==NULL)
        cout<<"List is empty"<<endl;
    else if(root->next==NULL){
            root=NULL;
            tail=NULL;
        }
    else{
        root=root->next;
        root->prev=NULL;
    }
    cout << "Deletion completed"<<endl;
}
//5
void  deleteLast(){
    if(root==NULL)
        cout<<"List is empty"<<endl;
    else if(root->next==NULL){
            root=NULL;
            tail=NULL;
        }
    else{
        tail=tail->prev;
        tail->next=NULL;
    }
    cout << "Deletion completed"<<endl;
}
//6-a
void deleteMiddleByValue(int val){
    if(root==NULL)
        cout<<"List is empty"<<endl;
    else if(val==root->data){
         if(root->next==NULL){
            root=NULL;
            tail=NULL;
        }
        else{
            root=root->next;
            root->prev=NULL;
        }
    }
    else{
        node *ptr=root;
        while(ptr->next !=NULL && val != ptr->next->data)
            ptr=ptr->next;
        if(ptr->next==NULL)
            cout<<"Invalid Value"<<endl;
        else{
            node *ptr1=ptr->next;
            ptr->next=ptr1->next;
            if(ptr->next!=NULL)
                ptr1->next->prev=ptr;
            else{
                tail=ptr;
            }
            cout << "Deletion completed"<<endl;
        }
    }
}
//6-b
void deleteMiddleByPosition(int pos){
    if(root==NULL)
        cout<<"List is empty"<<endl;
    else if(pos==1){
         if(root->next==NULL){
            root=NULL;
            tail=NULL;
        }
        else{
            root=root->next;
            root->prev=NULL;
        }
    }
    else{
        node *ptr=root;
        for(int i=1; i<pos-1 && ptr->next !=NULL; i++)
            ptr=ptr->next;
        if(ptr->next==NULL)
            cout<<"Invalid position"<<endl;
        else{
            node *ptr1=ptr->next;
            ptr->next=ptr1->next;
            if(ptr->next!=NULL)
                ptr1->next->prev=ptr;
            else{
                tail=ptr;
            }
            cout << "Deletion completed"<<endl;
        }
    }
}
