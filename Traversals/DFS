#include<bits/stdc++.h>
using namespace std;

void DFS(vector<int>V[],vector<int>&visited,int a){
    visited[a]=1;
    cout<<a<<" ";
    for(int i: V[a]){
        if(!visited[i]){
            DFS(V,visited,i);
        }
    }
}

void DFS_Traversal(vector<int> V[], int n, int a){
    vector<int>visited(n+1,0);
    cout<<"Visit order: ";
    DFS(V, visited, a);
    for(int i = 1; i <= n; i++)
{
    if(!visited[i]){
        cout<<endl;
        DFS(V, visited, i);
    }
    
}

}

int main(){
    int n,e;
    cout<<"Enter number of nodes: ";
    cin>>n;
    cout<<"Enter number of edges: ";
    cin>>e;
    cout<<"Enter connections in the graph: ";
    vector<int>V[n+1];
    for(int i=0;i<e;i++){
        int nodeA,nodeB;
        cin>>nodeA>>nodeB;
        V[nodeA].push_back(nodeB);
        V[nodeB].push_back(nodeA);
    }
    cout<<"Enter source: ";
    int a;
    cin>>a;
    DFS_Traversal(V, n, a);

}