#include<bits/stdc++.h>
using namespace std;

void DFS(vector<int> V[], vector<int> &visited, stack<int> &st, int u)
{
    visited[u] = 1;

    for(int v : V[u])
    {
        if(!visited[v])
            DFS(V, visited, st, v);
    }

    st.push(u);
}

void TopologicalSort(vector<int> V[], int n)
{
    vector<int> visited(n + 1, 0);
    stack<int> st;

    for(int i = 1; i <= n; i++)
    {
        if(!visited[i])
            DFS(V, visited, st, i);
    }

    cout << "Topological Order: ";

    while(!st.empty())
    {
        cout << st.top() << " ";
        st.pop();
    }
}

int main()
{
    int n, e;

    cout << "Enter number of nodes: ";
    cin >> n;

    cout << "Enter number of edges: ";
    cin >> e;

    vector<int> V[n + 1];

    cout << "Enter directed edges: ";
    for(int i = 0; i < e; i++)
    {
        int u, v;
        cin >> u >> v;

        V[u].push_back(v);
    }

    TopologicalSort(V, n);

    return 0;
}