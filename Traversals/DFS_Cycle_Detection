//For undirected graphs

#include<bits/stdc++.h>
using namespace std;

bool DFS(vector<int>V[],vector<int>&visited,int a,int parent){
    visited[a]=1;
    //cout<<a<<" ";
    for(int i: V[a]){
        if(!visited[i]){
            if(DFS(V, visited, i, a))
                return true;
        }
        else if(i != parent){
            return true;
        }
    }
    return false;
}

void DFS_Traversal(vector<int> V[], int n){
    vector<int>visited(n+1,0);
    //cout<<"Visit order: ";
    //DFS(V, visited, a);
    for(int i = 1; i <= n; i++)
{
    if(!visited[i]){
        if(DFS(V,visited,i,-1))
            {
                cout<<"Cycle Found";
                return;
            }
    }
    
}
cout<<"No cycle";
}

int main(){
    int n,e;
    cout<<"Enter number of nodes: ";
    cin>>n;
    cout<<"Enter number of edges: ";
    cin>>e;
    cout<<"Enter connections in the graph: ";
    vector<int>V[n+1];
    for(int i=0;i<e;i++){
        int nodeA,nodeB;
        cin>>nodeA>>nodeB;
        V[nodeA].push_back(nodeB);
        V[nodeB].push_back(nodeA);
    }

    DFS_Traversal(V, n);

}
